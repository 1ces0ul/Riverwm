---@param modes_option table<table<string,string>>
local function setup_modes(modes_option)
	for _, mode in ipairs(modes_option) do
		local mode_name = mode.name
		local modifiers = mode.mod

		-- Declare the mode
		exec("riverctl declare-mode " .. mode_name)

		-- Setup key bindings to enter/exit the mode
		exec(fmt("riverctl map normal %s %s enter-mode %s", modifiers, mode.key, mode_name))
		exec(fmt("riverctl map %s %s %s enter-mode normal", mode_name, modifiers, mode.key))
	end
end

-- Mappings for tag management
-- These mappings are repeated, so they are separated from the mappings table
local function tag_mappings()
	for i = 1, tag_count do
		local tag_mask = bit.lshift(1, i - 1) -- 1 << (i - 1)
		local opt = pinned_keyboard_layout ~= nil and fmt("-layout %s ", pinned_keyboard_layout) or ""

		-- Super+[1-8] to set specified tag output (tag-mask) as current focused tag output
		exec(fmt("riverctl map %snormal Super %s set-focused-tags %s", opt, i, tag_mask))

		-- Super+Shift+[1-8] to set/move focused view/window onto specified tag output [0-7]
		exec(fmt("riverctl map %snormal Super+Shift %s set-view-tags %s", opt, i, tag_mask))

		-- Super+Control+[1-8] to toggle (copying of specified) tag output [0-7] onto current focused tag output
		exec(fmt("riverctl map %snormal Super+Control %s toggle-focused-tags %s", opt, i, tag_mask))

		-- Super+Control+Shift+[1-8] to toggle (sending a copy of) current focused view/window onto specified tag output [0-7]
		exec(fmt("riverctl map %snormal Super+Control+Shift %s toggle-view-tags %s", opt, i, tag_mask))
	end

	-- Super+0 to focus all configured tags
	-- Super+Shift+0 to tag focused view/window with all configured tags
	local opt = pinned_keyboard_layout ~= nil and fmt("-layout %s ", pinned_keyboard_layout) or ""
	exec(fmt("riverctl map %snormal Super 0 set-focused-tags %s", opt, normal_tags_mask))
	exec(fmt("riverctl map %snormal Super+Shift 0 set-view-tags %s", opt, normal_tags_mask))
end

-- Mappings for scratchpad tag management
local function scratchpad_tag_mappings()
	-- The scratchpad lives on tag 9, outside the visible 1-8 workspace set.
	local opt = pinned_keyboard_layout ~= nil and fmt("-layout %s ", pinned_keyboard_layout) or ""

	-- Clear old tag-9 toggle mappings that may remain after reloading older configs.
	exec("riverctl unmap normal Super+Control 9 2>/dev/null")
	exec("riverctl unmap normal Super+Control+Shift 9 2>/dev/null")

	-- Toggle viewing the scratchpad on the current tag output with Super+S
	exec(fmt("riverctl map %snormal Super S toggle-focused-tags %s", opt, scratch_tags))

	-- Send view/window to the scratchpad with Super+Shift+S
	exec(fmt("riverctl map %snormal Super+Shift S set-view-tags %s", opt, scratch_tags))

	-- Focus the scratchpad tag directly with Super+9
	exec(fmt("riverctl map %snormal Super 9 set-focused-tags %s", opt, scratch_tags))

	-- Send view/window to the scratchpad tag directly with Super+Shift+9
	exec(fmt("riverctl map %snormal Super+Shift 9 set-view-tags %s", opt, scratch_tags))

	-- Set spawn tagmask to ensure new windows don't have the scratchpad tag unless explicitly set.
	exec(fmt("riverctl spawn-tagmask %s", normal_tags_mask))
end

---@param tag number
local function workspace(tag)
	return bit.lshift(1, tag - 1)
end

