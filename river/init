-- pick random wallpaper (use Lua instead of ls|shuf)
local function random_wallpaper(dir)
	local handle = io.popen(fmt("find %s -type f", dir))
	if not handle then
		return ""
	end
	local files = {}
	for f in handle:lines() do
		table.insert(files, f)
	end
	handle:close()
	if #files == 0 then
		return ""
	end
	math.randomseed(os.time())
	return files[math.random(#files)]
end

