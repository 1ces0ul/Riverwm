local function parse_outputs()
	local raw_outputs = popen("wlr-randr")
	local outputs = {}
	local current_output = nil

	for line in (raw_outputs .. "\n"):gmatch("([^\n]*)\n") do
		local output_name = line:match("^([^%s]+)%s")
		if output_name and not line:match("^%s") then
			current_output = {
				name = output_name,
				enabled = false,
			}
			table.insert(outputs, current_output)
		elseif current_output then
			local enabled = line:match("^%s+Enabled:%s+(%S+)")
			if enabled then
				current_output.enabled = enabled == "yes"
			end

			local resolution, refresh, flags = line:match("^%s+(%d+x%d+)%s+px,%s+([%d%.]+)%s+Hz%s*(.*)$")
			if resolution and refresh then
				local mode = fmt("%s@%sHz", resolution, refresh)
				current_output.first_mode = current_output.first_mode or mode
				if flags:find("current") then
					current_output.current_mode = mode
				end
				if flags:find("preferred") then
					current_output.preferred_mode = mode
				end
			end
		end
	end

	return outputs
end

local function output_mode(output, fallback_mode)
	return output and (output.current_mode or output.preferred_mode or output.first_mode) or fallback_mode
end

local function output_args(output, position_args, fallback_mode)
	local args = { "--output", shell_quote(output.name), "--on" }
	local mode = output_mode(output, fallback_mode)
	if mode then
		table.insert(args, "--mode")
		table.insert(args, shell_quote(mode))
	end
	table.insert(args, position_args)
	table.insert(args, "--scale")
	table.insert(args, "1")
	return cmd(args)
end

local function apply_output_profile()
	local outputs = parse_outputs()
	local internal = nil
	local external_outputs = {}

	for _, output in ipairs(outputs) do
		if output.name == internal_output then
			internal = output
		else
			table.insert(external_outputs, output)
		end
	end

	local wlr_args = {}
	local focus_output = nil

	if #external_outputs == 0 then
		internal = internal or { name = internal_output }
		table.insert(wlr_args, output_args(internal, "--pos 0,0", internal_output_mode))
		focus_output = internal_output
	elseif internal and internal.enabled then
		table.insert(wlr_args, output_args(internal, "--pos 0,0", internal_output_mode))

		local previous_output = internal.name
		for _, output in ipairs(external_outputs) do
			table.insert(wlr_args, output_args(output, "--right-of " .. shell_quote(previous_output)))
			previous_output = output.name
		end
	else
		local previous_output = ""
		for index, output in ipairs(external_outputs) do
			local position_args
			if index == 1 then
				position_args = "--pos 0,0"
			else
				position_args = "--right-of " .. shell_quote(previous_output)
			end
			table.insert(wlr_args, output_args(output, position_args))
			previous_output = output.name or previous_output
		end
		focus_output = external_outputs[1].name
	end

	if #wlr_args == 0 then
		return
	end

	exec("wlr-randr " .. cmd(wlr_args))
	if focus_output then
		exec("riverctl focus-output " .. shell_quote(focus_output))
	end
end

if arg and arg[1] == "--apply-output-profile" then
	apply_output_profile()
	os.exit(0)
elseif arg and arg[1] == "--toggle-internal-output" then
	exec("wlr-randr --output " .. shell_quote(internal_output) .. " --toggle")
	apply_output_profile()
	os.exit(0)
end

