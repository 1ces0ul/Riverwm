-- 显示器电源管理功能
local function setup_display_power_management()
	local pidfile = "/tmp/river-swayidle.pid"
	local old_pid = popen(fmt("cat %s 2>/dev/null", shell_quote(pidfile)))
	if old_pid:match("^%d+$") then
		os.execute(fmt("kill %s >/dev/null 2>&1", old_pid))
	end

	local swayidle_cmd = [[swayidle -w timeout 300 'wlopm --off "*"' resume 'wlopm --on "*"']]
	os.execute(fmt("sh -c %s", shell_quote(swayidle_cmd .. " & echo $! > " .. pidfile)))
end

-- 调用函数
